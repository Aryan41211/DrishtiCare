data/models/checkpoints/

# Large single analysis artifact (116 MB) - exceeds GitHub 100 MB file limit
data/analysis/day8/lesions/lesion_features.mat

# MA-CNN regenerable datasets (built by buildMaDataset.m / hardNegMineMaCnn.m)
